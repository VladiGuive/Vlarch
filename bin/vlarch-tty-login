#!/usr/bin/env bash
# vlarch-tty-login - tty1 autologin: optional first-boot, then Hyprland.
# Must never kill the tty session — fall through to the shell on any failure.

_vlarch_on_tty1() {
  [[ -n "${WAYLAND_DISPLAY-}" ]] && return 1
  case "$(tty 2>/dev/null || true)" in
    /dev/tty1) return 0 ;;
  esac
  [[ ${XDG_VTNR:-0} -eq 1 ]]
}

if ! _vlarch_on_tty1; then
  exit 0
fi

if [[ -f /var/lib/vlarch/first-boot.pending ]] && command -v vlarch >/dev/null 2>&1; then
  (vlarch first-boot >>/var/log/vlarch-first-boot.log 2>&1) &
fi

# Hyprland 0.53+ ships /usr/bin/start-hyprland; never shadow it under /usr/local/bin.
_hyprland_launcher="/usr/bin/start-hyprland"
if [[ -x "$_hyprland_launcher" ]]; then
  exec "$_hyprland_launcher"
fi

if command -v Hyprland >/dev/null 2>&1; then
  printf '[vlarch] start-hyprland missing; run: vlarch update\n' >&2
fi

exit 0
