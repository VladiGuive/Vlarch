#!/usr/bin/env bash
# vlarch-tty-login - tty1 autologin: first-boot (blocking), then Hyprland or login shell.
# Must never leave tty1 with no process — always exec Hyprland or the user's shell.

export PATH="/usr/local/bin:/usr/bin:${PATH:-/bin}"
export VLARCH_TTY_LOGIN=1

_vlarch_on_tty1() {
  [[ -n "${WAYLAND_DISPLAY-}" ]] && return 1
  case "$(tty 2>/dev/null || true)" in
    /dev/tty1) return 0 ;;
  esac
  [[ ${XDG_VTNR:-0} -eq 1 ]]
}

_vlarch_login_shell() {
  local shell configured_shell
  configured_shell=/etc/vlarch/login-shell
  if [[ -r "$configured_shell" ]]; then
    shell="$(<"$configured_shell")"
  else
    shell="$(getent passwd "${USER:-root}" 2>/dev/null | cut -d: -f7-)"
  fi
  [[ -n "$shell" && -x "$shell" ]] || shell=""
  if [[ -z "$shell" ]]; then
    command -v zsh >/dev/null 2>&1 && shell="$(command -v zsh)"
  fi
  [[ -n "$shell" && -x "$shell" ]] || shell="/bin/bash"
  printf '%s' "$shell"
}

_vlarch_first_boot_log() {
  local dir="${XDG_CACHE_HOME:-${HOME}/.cache}/vlarch"
  mkdir -p "$dir"
  printf '%s/first-boot.log' "$dir"
}

if ! _vlarch_on_tty1; then
  _shell="$(< /etc/vlarch/login-shell 2>/dev/null || true)"
  [[ -x "$_shell" ]] || _shell="/bin/bash"
  exec -l "$_shell" "$@"
fi

_first_log="$(_vlarch_first_boot_log)"
_pending=/var/lib/vlarch/first-boot.pending
_attempted=/run/vlarch/first-boot.attempted

if [[ -f "$_pending" ]] && [[ ! -f "$_attempted" ]] && command -v vlarch >/dev/null 2>&1; then
  mkdir -p /run/vlarch 2>/dev/null || sudo mkdir -p /run/vlarch
  if ! touch "$_attempted" 2>/dev/null; then
    sudo touch "$_attempted"
  fi
  printf '\n[vlarch] First boot — enabling network and installing desktop...\n'
  printf '[vlarch] Log: %s\n\n' "$_first_log"
  if vlarch first-boot 2>&1 | tee -a "$_first_log"; then
    :
  else
    printf '\n[vlarch] first-boot failed; log: %s\n' "$_first_log" >&2
    printf '[vlarch] Fix network, then run: sudo vlarch first-boot --force\n\n' >&2
  fi
elif [[ -f "$_pending" ]] && [[ -f "$_attempted" ]]; then
  printf '\n[vlarch] first-boot already tried this boot; see %s\n' "$_first_log" >&2
  printf '[vlarch] Retry: sudo vlarch first-boot --force\n\n' >&2
fi

_hyprland_launcher="/usr/bin/start-hyprland"
if [[ -x "$_hyprland_launcher" ]]; then
  exec "$_hyprland_launcher"
fi

if command -v Hyprland >/dev/null 2>&1; then
  printf '[vlarch] start-hyprland missing; run: sudo vlarch update\n' >&2
elif [[ -f "$_pending" ]]; then
  printf '[vlarch] first-boot did not finish; see %s\n' "$_first_log" >&2
else
  printf '[vlarch] Hyprland not installed; run: sudo vlarch update\n' >&2
fi

exec -l "$(_vlarch_login_shell)"
