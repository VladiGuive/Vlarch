#!/usr/bin/env bash
# vlarch-theme-generate - regenerate Nord-themed dotfiles from dotfiles/theme/nord.json

set -euo pipefail

self="${BASH_SOURCE[0]:-}"
self_dir="$(cd -- "$(dirname -- "$self")" && pwd -P)"
root="$(cd -- "${self_dir}/.." && pwd -P)"

exec python3 "${root}/scripts/generate-nord-theme.py" "$@"
