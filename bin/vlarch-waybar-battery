#!/usr/bin/env bash
# Waybar: battery status (sysfs + upower; hidden when no battery hardware).

set -euo pipefail

VLARCH_WAYBAR_BATTERY_SIGNAL="${VLARCH_WAYBAR_BATTERY_SIGNAL:-3}"

_vlarch_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

vlarch_waybar_battery_refresh() {
  pgrep -x waybar >/dev/null 2>&1 || return 0
  pkill "-SIGRTMIN+${VLARCH_WAYBAR_BATTERY_SIGNAL}" waybar 2>/dev/null \
    || killall -SIGUSR2 waybar 2>/dev/null \
    || true
}

vlarch_waybar_battery_sysfs_entries() {
  local d name type
  shopt -s nullglob
  for d in /sys/class/power_supply/*; do
    [[ -d "$d" ]] || continue
    name=$(basename "$d")
    type=""
    if [[ -f "$d/type" ]]; then
      type=$(tr -d '[:space:]' <"$d/type" 2>/dev/null || true)
    fi
    if [[ "${type,,}" == "battery" ]]; then
      printf '%s\n' "$name"
      continue
    fi
    if [[ "$name" =~ ^(BAT|CMB|battery) ]]; then
      printf '%s\n' "$name"
    fi
  done
  shopt -u nullglob
}

vlarch_waybar_battery_upower_entries() {
  command -v upower >/dev/null 2>&1 || return 0
  local dev
  while IFS= read -r dev; do
    [[ -n "$dev" ]] || continue
    [[ "$dev" == *battery* ]] || continue
    [[ "$dev" == *DisplayDevice* ]] && continue
    printf '%s\n' "$dev"
  done < <(upower -e 2>/dev/null || true)
}

vlarch_waybar_battery_has() {
  vlarch_waybar_battery_sysfs_entries | grep -q . \
    && return 0
  vlarch_waybar_battery_upower_entries | grep -q .
}

vlarch_waybar_battery_sysfs_ratio() {
  local now_file="$1" full_file="$2"
  local now full
  [[ -f "$now_file" && -f "$full_file" ]] || return 1
  now=$(tr -d '[:space:]' <"$now_file" 2>/dev/null || true)
  full=$(tr -d '[:space:]' <"$full_file" 2>/dev/null || true)
  [[ "$now" =~ ^[0-9]+$ && "$full" =~ ^[0-9]+$ && "$full" -gt 0 ]] || return 1
  printf '%s' $((now * 100 / full))
}

vlarch_waybar_battery_sysfs_capacity() {
  local bat="$1" cap base="/sys/class/power_supply/$bat"

  if [[ -f "$base/capacity" ]]; then
    cap=$(tr -d '[:space:]' <"$base/capacity" 2>/dev/null || true)
    if [[ "$cap" =~ ^[0-9]+$ && "$cap" -le 100 ]]; then
      printf '%s' "$cap"
      return 0
    fi
  fi

  vlarch_waybar_battery_sysfs_ratio "$base/charge_now" "$base/charge_full" && return 0
  vlarch_waybar_battery_sysfs_ratio "$base/charge_now" "$base/charge_full_design" && return 0
  vlarch_waybar_battery_sysfs_ratio "$base/energy_now" "$base/energy_full" && return 0
  vlarch_waybar_battery_sysfs_ratio "$base/energy_now" "$base/energy_full_design" && return 0

  return 1
}

vlarch_waybar_battery_sysfs_status() {
  local bat="$1" base="/sys/class/power_supply/$bat"
  [[ -f "$base/status" ]] || return 0
  tr -d '[:space:]' <"$base/status" 2>/dev/null || true
}

vlarch_waybar_battery_plugged_sysfs() {
  local d name type online
  shopt -s nullglob
  for d in /sys/class/power_supply/*; do
    [[ -d "$d" ]] || continue
    name=$(basename "$d")
    type=""
    if [[ -f "$d/type" ]]; then
      type=$(tr -d '[:space:]' <"$d/type" 2>/dev/null || true)
    fi
    if [[ "${type,,}" != "mains" && "${type,,}" != "usb" && ! "$name" =~ ^(AC|ACAD|ADP|ADP0|Mains) ]]; then
      continue
    fi
    [[ -f "$d/online" ]] || continue
    online=$(tr -d '[:space:]' <"$d/online" 2>/dev/null || true)
    [[ "$online" == "1" ]] && return 0
  done
  shopt -u nullglob
  return 1
}

vlarch_waybar_battery_parse_upower() {
  local dev="$1"
  python3 - "$dev" <<'PY'
import re
import subprocess
import sys

dev = sys.argv[1]
try:
    text = subprocess.check_output(["upower", "-i", dev], text=True, stderr=subprocess.DEVNULL)
except (subprocess.CalledProcessError, FileNotFoundError):
    sys.exit(1)

fields = {}
for line in text.splitlines():
    m = re.match(r"^\s+([^:]+):\s+(.*)$", line)
    if m:
        fields[m.group(1).strip()] = m.group(2).strip()

raw = fields.get("percentage", "").rstrip("%").strip()
if not raw:
    sys.exit(1)
try:
    pct = int(float(raw.replace(",", ".")))
except ValueError:
    sys.exit(1)

state = fields.get("state", "").lower()
charging = 1 if state == "charging" else 0
plugged = 1 if state in {"fully-charged", "pending-charge"} else 0
print(pct)
print(charging)
print(plugged)
PY
}

vlarch_waybar_battery_read_upower() {
  local dev pct charging plugged sum=0 count=0
  local -a parts=()

  while IFS= read -r dev; do
    [[ -n "$dev" ]] || continue
    if ! parts=($(vlarch_waybar_battery_parse_upower "$dev" 2>/dev/null || true)); then
      continue
    fi
    [[ "${#parts[@]}" -eq 3 ]] || continue
    pct="${parts[0]}"
    [[ "$pct" =~ ^[0-9]+$ ]] || continue
    sum=$((sum + pct))
    count=$((count + 1))
    [[ "${parts[1]}" == "1" ]] && charging=1
    [[ "${parts[2]}" == "1" ]] && plugged=1
  done < <(vlarch_waybar_battery_upower_entries)

  ((count > 0)) || return 1

  if vlarch_waybar_battery_plugged_sysfs; then
    plugged=1
  fi

  printf '%s %s %s\n' $((sum / count)) "$charging" "$plugged"
}

vlarch_waybar_battery_read_sysfs() {
  local bat capacity status sum=0 count=0 charging=0 plugged=0

  if vlarch_waybar_battery_plugged_sysfs; then
    plugged=1
  fi

  while IFS= read -r bat; do
    [[ -n "$bat" ]] || continue
    capacity="$(vlarch_waybar_battery_sysfs_capacity "$bat" 2>/dev/null || true)"
    [[ "$capacity" =~ ^[0-9]+$ ]] || continue
    sum=$((sum + capacity))
    count=$((count + 1))
    status="$(vlarch_waybar_battery_sysfs_status "$bat")"
    [[ "$status" == "Charging" ]] && charging=1
  done < <(vlarch_waybar_battery_sysfs_entries)

  ((count > 0)) || return 1
  printf '%s %s %s\n' $((sum / count)) "$charging" "$plugged"
}

vlarch_waybar_battery_icon() {
  local capacity="$1" charging="$2" plugged="$3"
  local -a icons_discharging=('' '' '' '' '')
  local -a icons_charging=('󰂎' '󰂍' '󰂌' '󰂋' '󰂆')
  local idx=0

  if [[ "$plugged" == "1" && "$charging" != "1" && "$capacity" -ge 99 ]]; then
    printf '󰚥'
    return 0
  fi

  if ((capacity >= 80)); then idx=4
  elif ((capacity >= 60)); then idx=3
  elif ((capacity >= 40)); then idx=2
  elif ((capacity >= 20)); then idx=1
  else idx=0
  fi

  if [[ "$charging" == "1" ]]; then
    printf '%s' "${icons_charging[$idx]}"
  else
    printf '%s' "${icons_discharging[$idx]}"
  fi
}

vlarch_waybar_battery_emit() {
  local capacity="$1" charging="$2" plugged="$3"
  local icon tooltip classes="" class

  if [[ "$charging" == "1" ]]; then
    classes="charging"
  fi
  if ((capacity <= 15)); then
    classes="${classes:+$classes }critical"
  elif ((capacity <= 30)); then
    classes="${classes:+$classes }warning"
  fi

  icon="$(vlarch_waybar_battery_icon "$capacity" "$charging" "$plugged")"

  if [[ "$charging" == "1" ]]; then
    tooltip="${capacity}% — Charging"
  elif [[ "$plugged" == "1" ]]; then
    tooltip="${capacity}% — Plugged in"
  else
    tooltip="${capacity}% — Discharging"
  fi

  if [[ -n "$classes" ]]; then
    class=$(_vlarch_json_escape "$classes")
    printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
      "$(_vlarch_json_escape "$icon")" \
      "$(_vlarch_json_escape "$tooltip")" \
      "$class"
  else
    printf '{"text":"%s","tooltip":"%s"}\n' \
      "$(_vlarch_json_escape "$icon")" \
      "$(_vlarch_json_escape "$tooltip")"
  fi
}

vlarch_waybar_battery_status() {
  local line capacity charging plugged

  # Prefer upower: sysfs often lists BAT1 but exposes no usable capacity.
  if line="$(vlarch_waybar_battery_read_upower 2>/dev/null || true)" && [[ -n "$line" ]]; then
    read -r capacity charging plugged <<<"$line"
    vlarch_waybar_battery_emit "$capacity" "$charging" "$plugged"
    return 0
  fi

  if line="$(vlarch_waybar_battery_read_sysfs 2>/dev/null || true)" && [[ -n "$line" ]]; then
    read -r capacity charging plugged <<<"$line"
    vlarch_waybar_battery_emit "$capacity" "$charging" "$plugged"
    return 0
  fi

  printf '{"text":""}\n'
}

vlarch_waybar_battery_debug() {
  local bat dev
  printf 'sysfs power_supply:\n'
  ls -la /sys/class/power_supply/ 2>&1 || true
  printf '\nsysfs battery entries:\n'
  vlarch_waybar_battery_sysfs_entries || true
  while IFS= read -r bat; do
    [[ -n "$bat" ]] || continue
    printf '  %s files: ' "$bat"
    ls "/sys/class/power_supply/$bat" 2>/dev/null | tr '\n' ' ' || true
    printf '\n  %s capacity read: ' "$bat"
    vlarch_waybar_battery_sysfs_capacity "$bat" 2>/dev/null || printf 'failed'
    printf '\n'
  done < <(vlarch_waybar_battery_sysfs_entries)
  printf '\nupower -e:\n'
  upower -e 2>&1 || true
  printf '\nupower battery entries:\n'
  vlarch_waybar_battery_upower_entries || true
  while IFS= read -r dev; do
    [[ -n "$dev" ]] || continue
    printf '  %s metrics: ' "$dev"
    vlarch_waybar_battery_parse_upower "$dev" 2>/dev/null || printf 'failed'
    printf '\n'
  done < <(vlarch_waybar_battery_upower_entries)
  printf '\nhas: %s\n' "$(vlarch_waybar_battery_has && printf yes || printf no)"
  printf 'status: '
  vlarch_waybar_battery_status
}

case "${1:---status}" in
  --status)  vlarch_waybar_battery_status ;;
  --has)
    if vlarch_waybar_battery_has; then
      printf 'yes\n'
      exit 0
    fi
    printf 'no\n'
    exit 1
    ;;
  --debug)   vlarch_waybar_battery_debug ;;
  --refresh) vlarch_waybar_battery_refresh ;;
  -h|--help)
    printf 'usage: %s [--status|--has|--debug|--refresh]\n' "$(basename "$0")"
    ;;
  *)
    printf 'unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac
