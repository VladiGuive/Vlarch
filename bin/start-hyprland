#!/usr/bin/env bash
# start-hyprland - launch Hyprland on tty1 when not already in a Wayland session.

if [[ -n "${WAYLAND_DISPLAY-}" ]] || [[ ${XDG_VTNR:-0} -ne 1 ]]; then
  exit 0
fi

if ! command -v Hyprland >/dev/null 2>&1; then
  printf '[vlarch] Hyprland not installed; run: curl -fsSL https://vlarch.vladi.tech/update.sh | sudo bash\n' >&2
  exit 0
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec Hyprland
