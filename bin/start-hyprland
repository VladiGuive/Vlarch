#!/usr/bin/env bash
# start-hyprland - launch Hyprland on tty1 when not already in a Wayland session.

_vlarch_on_tty1() {
  [[ -n "${WAYLAND_DISPLAY-}" ]] && return 1
  case "$(tty 2>/dev/null || true)" in
    /dev/tty1) return 0 ;;
  esac
  [[ ${XDG_VTNR:-0} -eq 1 ]]
}

if ! _vlarch_on_tty1; then
  exit 0
fi

if ! command -v Hyprland >/dev/null 2>&1; then
  printf '[vlarch] Hyprland not installed; run: vlarch update\n' >&2
  exit 0
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec Hyprland
