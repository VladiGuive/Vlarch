#!/usr/bin/env bash
# vlarch-edge - launch Microsoft Edge with flags.conf (bypass AUR wrapper x11 override).

set -eo pipefail

export PATH="/usr/local/bin:/usr/bin:/bin:${PATH:-}"

if [[ -z "${HOME:-}" ]]; then
  HOME="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)" || HOME="/tmp"
  export HOME
fi

EDGE="/opt/microsoft/msedge/microsoft-edge"
FLAGS="${XDG_CONFIG_HOME:-${HOME}/.config}/microsoft-edge-stable-flags.conf"

if [[ ! -x "$EDGE" ]]; then
  printf 'vlarch-edge: %s not found\n' "$EDGE" >&2
  exit 1
fi

flag_args=()
if [[ -f "$FLAGS" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}}"
    line="${line%"${line##*[![:space:]]}"}}"
    [[ -n "$line" ]] && flag_args+=("$line")
  done <"$FLAGS"
fi

if ((${#flag_args[@]})); then
  exec "$EDGE" "${flag_args[@]}" "$@"
else
  exec "$EDGE" "$@"
fi
