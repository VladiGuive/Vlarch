#!/usr/bin/env bash
# vlarch - personal Arch flavor CLI. Lives at /usr/local/bin/vlarch on the
# installed system (placed there by install/steps/10_finalize.sh).
#
# Help is auto-generated from `# vlarch:summary=` comments above each
# subcommand function in this file.

set -euo pipefail

VLARCH_INFO_FILE="${VLARCH_INFO_FILE:-/etc/vlarch/install-info}"
VLARCH_STATE_DIR="${VLARCH_STATE_DIR:-/var/lib/vlarch}"
VLARCH_VERBOSE="${VLARCH_VERBOSE:-0}"
VLARCH_FIRST_BOOT_MARKER="${VLARCH_STATE_DIR}/first-boot.pending"
VLARCH_POST_INSTALL_MARKER="${VLARCH_STATE_DIR}/post-install.done"
VLARCH_RUNTIME_ENV="${VLARCH_STATE_DIR}/runtime.env"

_log()  { printf '[vlarch] %s\n' "$*"; }
_vlog() {
  if ((VLARCH_VERBOSE)); then
    printf '[vlarch] %s\n' "$*"
  fi
}
_warn() { printf '[vlarch] warning: %s\n' "$*" >&2; }
_die()  { printf '[vlarch] error: %s\n' "$*" >&2; exit 1; }

_install_info_branch() {
  local branch=""
  [[ -f "$VLARCH_INFO_FILE" ]] || { printf '%s' main; return 0; }
  branch="$(grep -E '^branch=' "$VLARCH_INFO_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
  printf '%s' "${branch:-main}"
}

_cdn_base_for_branch() {
  local branch="${1:-main}"
  branch="${branch//\//-}"
  if [[ "$branch" == main ]]; then
    printf 'https://vlarch.vladi.tech'
  else
    printf 'https://vlarch-%s.vladi.tech' "$branch"
  fi
}

_vlarch_source_version_lib() {
  local lib share="${VLARCH_SHARE_DIR:-/usr/local/share/vlarch}"

  lib="${share}/version.sh"
  if [[ -f "$lib" ]]; then
    # shellcheck disable=SC1090
    source "$lib"
    return 0
  fi

  local self_root=""
  local self="${BASH_SOURCE[0]:-}"
  if [[ -n "$self" && -f "$self" ]]; then
    self_root="$(cd -- "$(dirname -- "$self")" && pwd -P)"
    lib="${self_root}/../lib/version.sh"
    if [[ -f "$lib" ]]; then
      # shellcheck disable=SC1090
      source "$lib"
      return 0
    fi
  fi

  if [[ -n "${VLARCH_CDN_BASE:-}" ]]; then
    lib="$(mktemp)"
    if curl -fsSL --max-time 10 "${VLARCH_CDN_BASE}/lib/version.sh" -o "$lib" 2>/dev/null; then
      # shellcheck disable=SC1090
      source "$lib"
      rm -f "$lib"
      return 0
    fi
    rm -f "$lib"
  fi

  return 1
}

_install_info_version() {
  [[ -f "$VLARCH_INFO_FILE" ]] || return 1
  grep -E '^version=' "$VLARCH_INFO_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]'
}

_fetch_remote_version() {
  curl -fsSL --max-time 10 "${VLARCH_CDN_BASE}/version.txt" | tr -d '[:space:]'
}

_install_info_set_branch() {
  local branch="$1" path="$VLARCH_INFO_FILE" tmp
  [[ -f "$path" ]] || _die "$path not found"
  [[ -n "$branch" ]] || _die "branch name cannot be empty"
  [[ "$branch" != *$'\n'* && "$branch" != *' '* && "$branch" != *'='* ]] \
    || _die "invalid branch name: $branch"

  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == branch=* ]]; then
      printf 'branch=%s\n' "$branch"
    else
      printf '%s\n' "$line"
    fi
  done <"$path" >"$tmp"
  if ! grep -q '^branch=' "$tmp"; then
    printf 'branch=%s\n' "$branch" >>"$tmp"
  fi
  install -m 0644 "$tmp" "$path"
  rm -f "$tmp"
}

_load_runtime_env() {
  if [[ -f "$VLARCH_RUNTIME_ENV" ]]; then
    # shellcheck disable=SC1090
    source "$VLARCH_RUNTIME_ENV"
  fi
}

_wifi_device() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}

_has_network() {
  if curl -fsS --max-time 5 -o /dev/null "${VLARCH_CDN_BASE:-https://vlarch.vladi.tech}/version.txt" 2>/dev/null; then
    return 0
  fi
  local connectivity
  connectivity="$(nmcli -t -f CONNECTIVITY general 2>/dev/null | tr -d '[:space:]')"
  if [[ "$connectivity" == "full" || "$connectivity" == "limited" ]]; then
    return 0
  fi
  getent hosts archlinux.org >/dev/null 2>&1
}

_try_wifi_connect() {
  [[ -n "${VLARCH_WIFI_SSID:-}" ]] || return 0
  command -v nmcli >/dev/null 2>&1 || return 0

  local dev
  dev="$(_wifi_device)"
  [[ -n "$dev" ]] || return 0

  nmcli radio wifi on >/dev/null 2>&1 || true
  nmcli device set "$dev" managed yes >/dev/null 2>&1 || true
  nmcli device wifi rescan >/dev/null 2>&1 || true
  sleep 2

  if nmcli device wifi connect "$VLARCH_WIFI_SSID" \
    ${VLARCH_WIFI_PASSWORD:+password "$VLARCH_WIFI_PASSWORD"} \
    >/dev/null 2>&1; then
    _vlog "Joined WiFi: $VLARCH_WIFI_SSID"
    return 0
  fi
  return 1
}

_wait_for_network() {
  local quiet=0 connect=0
  while (($#)); do
    case "$1" in
      --quiet)   quiet=1; shift ;;
      --connect) connect=1; shift ;;
      *) shift ;;
    esac
  done
  local timeout="${VLARCH_NETWORK_TIMEOUT:-180}"
  local elapsed=0 interval=3

  if ((!quiet)); then _log "Waiting for network (up to ${timeout}s)..."; fi
  if ((connect)); then
    _try_wifi_connect || { if ((!quiet)); then _warn "could not join ${VLARCH_WIFI_SSID:-WiFi} yet"; fi; }
  fi

  while ((elapsed < timeout)); do
    if _has_network; then
      if ((!quiet)); then _log "Network ready"; fi
      return 0
    fi
    if ((connect && elapsed > 0 && elapsed % 15 == 0)); then
      if ((!quiet)); then _log "Still waiting; retrying WiFi..."; fi
      _try_wifi_connect || true
    fi
    sleep "$interval"
    elapsed=$((elapsed + interval))
  done

  _die "network not available after ${timeout}s"
}

# Vlarch targets wheel users with NOPASSWD sudo; re-exec once so every subcommand
# runs as root (state under /var/lib/vlarch, systemctl, timeshift, etc.).
VLARCH_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[[ -n "$VLARCH_SELF" && -x "$VLARCH_SELF" ]] || VLARCH_SELF="$(command -v -- "${BASH_SOURCE[0]}")"
[[ -n "$VLARCH_SELF" ]] || VLARCH_SELF="$0"

_ensure_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    return 0
  fi
  exec sudo \
    --preserve-env=VLARCH_INFO_FILE,VLARCH_STATE_DIR,VLARCH_FIRST_BOOT_MARKER,VLARCH_POST_INSTALL_MARKER,VLARCH_RUNTIME_ENV,VLARCH_CDN_BASE,VLARCH_VERBOSE,VLARCH_UI \
    "$VLARCH_SELF" "$@"
}

# vlarch:summary=Idempotent finalization (NetworkManager, WiFi).
cmd_post_install() {
  local force=0
  while (($#)); do
    case "$1" in
      --force) force=1; shift ;;
      *) _die "unknown option: $1" ;;
    esac
  done

  if ((!force)) && [[ -f "$VLARCH_POST_INSTALL_MARKER" ]]; then
    _log "post-install already ran; pass --force to re-run"
    return 0
  fi

  _log "Enabling and starting NetworkManager"
  systemctl enable --now NetworkManager.service >/dev/null 2>&1 \
    || _warn "could not enable NetworkManager"

  _load_runtime_env
  _wait_for_network --connect

  install -d -m 0755 "$VLARCH_STATE_DIR"
  touch "$VLARCH_POST_INSTALL_MARKER"
  _log "post-install done"
}

# vlarch:summary=One-shot first-login bootstrap; post-install then update from CDN.
cmd_first_boot() {
  local force=0
  while (($#)); do
    case "$1" in
      --force) force=1; shift ;;
      *) _die "unknown option: $1" ;;
    esac
  done

  if [[ ! -f "$VLARCH_FIRST_BOOT_MARKER" ]]; then
    ((force)) || return 0
  fi

  _log "First-boot bootstrap"
  if ((force)); then
    cmd_post_install --force
  else
    cmd_post_install
  fi
  cmd_update --force --verbose
  rm -f "$VLARCH_FIRST_BOOT_MARKER" /run/vlarch/first-boot.attempted 2>/dev/null || true
}

# vlarch:summary=Print install metadata recorded at install time.
cmd_version() {
  if [[ ! -f "$VLARCH_INFO_FILE" ]]; then
    _die "$VLARCH_INFO_FILE not found"
  fi
  if grep -q '^branch=' "$VLARCH_INFO_FILE"; then
    cat "$VLARCH_INFO_FILE"
  else
    cat "$VLARCH_INFO_FILE"
    printf 'branch=main\n'
  fi
}

# vlarch:summary=Show or set the git branch used for vlarch update.
cmd_branch() {
  if [[ ! -f "$VLARCH_INFO_FILE" ]]; then
    _die "$VLARCH_INFO_FILE not found"
  fi
  if (($# == 0)); then
    printf 'branch=%s\n' "$(_install_info_branch)"
    return 0
  fi
  (($# == 1)) || _die "usage: vlarch branch [name]"
  _install_info_set_branch "$1"
  _log "branch set to $1"
}

if [[ -z "${VLARCH_CDN_BASE:-}" ]]; then
  VLARCH_CDN_BASE="$(_cdn_base_for_branch "$(_install_info_branch)")"
fi
export VLARCH_CDN_BASE

# vlarch:summary=Apply ~/.overrides to managed dotfiles without a full update.
cmd_overrides() {
  command -v vlarch-overrides >/dev/null 2>&1 \
    || _die "vlarch-overrides not installed; run: vlarch update"
  vlarch-overrides "$@"
}

# vlarch:summary=Update Vlarch from CDN (packages, dotfiles, hyprpm, CLI).
cmd_update() {
  local url="${VLARCH_CDN_BASE}/update.sh"
  local rc=0
  local -a args=()
  local arg has_branch=0 has_force=0
  local local_ver remote_ver
  for arg in "$@"; do
    case "$arg" in
      --verbose|-v) VLARCH_VERBOSE=1 ;;
      --force) has_force=1 ;;
      --branch) has_branch=1; args+=("$arg") ;;
      *) args+=("$arg") ;;
    esac
  done
  if ((!has_branch)); then
    args=(--branch "$(_install_info_branch)" "${args[@]}")
  fi
  if ((!has_force)) && _vlarch_source_version_lib; then
    local_ver="$(_install_info_version)" || true
    remote_ver="$(_fetch_remote_version)" || true
    if [[ -n "$local_ver" && -n "$remote_ver" ]] \
      && vlarch_version_up_to_date "$local_ver" "$remote_ver"; then
      _log "already up to date (${local_ver})"
      return 0
    fi
  fi
  if ((VLARCH_VERBOSE)); then
    _vlog "Fetching update bootstrap from ${url}"
  else
    _log "Updating from ${url}"
  fi
  curl -fsSL "${url}" | bash -s -- "${args[@]}" || rc=$?
  if ((rc != 0)); then
    _die "update failed (exit ${rc}); try: vlarch update --verbose"
  fi
}

# vlarch:summary=Show this help.
cmd_help() {
  local sub="${1:-}"
  if [[ -n "$sub" ]]; then
    if declare -F "cmd_${sub//-/_}" >/dev/null 2>&1; then
      printf 'vlarch %s\n' "$sub"
      _summary_for "$sub" | sed 's/^/  /'
      return 0
    fi
    _die "unknown subcommand: $sub"
  fi
  printf 'vlarch - personal Arch CLI\n\nSubcommands:\n'
  local fn name summary
  while IFS= read -r fn; do
    name="${fn#cmd_}"
    name="${name//_/-}"
    summary="$(_summary_for "$name")"
    printf '  %-14s %s\n' "$name" "$summary"
  done < <(compgen -A function | grep '^cmd_' | sort)
}

# Pull `# vlarch:summary=...` from the line above the subcommand function.
_summary_for() {
  local name="$1"
  local fn="cmd_${name//-/_}"
  awk -v fn="$fn" '
    /^# vlarch:summary=/ { last=substr($0, index($0,"=")+1); next }
    $0 ~ "^"fn"\\(\\) \\{" { print last; exit }
    { last="" }
  ' "${BASH_SOURCE[0]}"
}

_needs_root() {
  case "${1:-}" in
    update|post-install|first-boot|overrides|branch) return 0 ;;
    *) return 1 ;;
  esac
}

main() {
  if (($# == 0)); then
    cmd_help
    return 0
  fi
  local sub="$1"
  shift
  local fn="cmd_${sub//-/_}"
  if ! declare -F "$fn" >/dev/null 2>&1; then
    _die "unknown subcommand: $sub (try 'vlarch help')"
  fi
  local -a args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --verbose|-v) VLARCH_VERBOSE=1 ;;
      *) args+=("$arg") ;;
    esac
  done
  "$fn" "${args[@]}"
}

if (($# > 0)) && _needs_root "$1"; then
  _ensure_root "$@"
fi
main "$@"
