#!/usr/bin/env bash
# Start elephant (wait for providers + app index), then walker --gapplication-service.

set +e

LOG="${VLARCH_WALKER_LOG:-/tmp/vlarch-walker-services.log}"

log() {
  printf '[vlarch-walker] %s\n' "$*" >>"$LOG"
}

_elephant_ready() {
  elephant l 2>/dev/null | grep -q desktopapplications
}

_elephant_has_menus() {
  elephant l 2>/dev/null | grep -q '^menus:'
}

_elephant_has_apps() {
  local out
  out="$(elephant query "desktopapplications;;50;false" 2>/dev/null || true)"
  [[ -n "$out" ]]
}

start_elephant() {
  command -v elephant >/dev/null 2>&1 || {
    log 'elephant not installed'
    return 1
  }

  if systemctl --user is-active --quiet elephant.service 2>/dev/null; then
    log 'elephant.service already active'
  else
    elephant service enable >>"$LOG" 2>&1 || true
    if ! systemctl --user start elephant.service >>"$LOG" 2>&1; then
      log 'systemctl start failed; falling back to background elephant'
      elephant >>"$LOG" 2>&1 &
    fi
  fi

  local i
  for i in $(seq 1 120); do
    if _elephant_ready && _elephant_has_apps && _elephant_has_menus; then
      log "elephant ready with apps and menus (${i} checks)"
      return 0
    fi
    sleep 0.25
  done

  if _elephant_ready && _elephant_has_apps; then
    log "elephant ready but menus missing: $(elephant l 2>&1 | tr '\n' ' ')"
    return 1
  fi

  if _elephant_ready; then
    log "elephant providers loaded but desktop query empty: $(elephant query 'desktopapplications;;5;false' 2>&1 | tr '\n' ' ')"
    return 0
  fi

  log "elephant not ready; providers: $(elephant l 2>&1 | tr '\n' ' ')"
  return 1
}

stop_walker_service() {
  local sock_dir
  sock_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/walker"

  command -v walker >/dev/null 2>&1 && walker -q 2>/dev/null || true
  pkill -f '[w]alker --gapplication-service' 2>/dev/null || true
  pkill -x walker 2>/dev/null || true
  rm -f "${sock_dir}/walker.sock" 2>/dev/null || true
  sleep 0.3
}

start_walker_service() {
  command -v walker >/dev/null 2>&1 || {
    log 'walker not installed'
    return 0
  }

  stop_walker_service

  # Drop inherited fds (e.g. vlarch update.lock flock) before daemonizing.
  local fd
  for fd in $(seq 3 255); do
    eval "exec ${fd}>&-" 2>/dev/null || true
  done

  walker --gapplication-service >>"$LOG" 2>&1 &
  log 'started walker --gapplication-service'

  local i sock
  sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/walker/walker.sock"
  for i in $(seq 1 40); do
    if [[ -S "$sock" ]]; then
      log "walker socket ready (${i} checks)"
      return 0
    fi
    sleep 0.1
  done

  log 'walker socket not ready after startup wait'
}

: >"$LOG"
start_elephant || true
start_walker_service
