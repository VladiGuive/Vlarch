#!/usr/bin/env bash
# Start elephant (wait for providers + app index), then walker --gapplication-service.

set +e

LOG="${VLARCH_WALKER_LOG:-/tmp/vlarch-walker-services.log}"

log() {
  printf '[vlarch-walker] %s\n' "$*" >>"$LOG"
}

_elephant_ready() {
  elephant l 2>/dev/null | grep -q desktopapplications
}

_elephant_has_apps() {
  local out
  out="$(elephant query "desktopapplications;;50;false" 2>/dev/null || true)"
  [[ -n "$out" ]]
}

start_elephant() {
  command -v elephant >/dev/null 2>&1 || {
    log 'elephant not installed'
    return 1
  }

  if systemctl --user is-active --quiet elephant.service 2>/dev/null; then
    systemctl --user restart elephant.service >>"$LOG" 2>&1 \
      || systemctl --user start elephant.service >>"$LOG" 2>&1 \
      || true
    log 'restarted elephant.service'
  else
    elephant service enable >>"$LOG" 2>&1 || true
    if ! systemctl --user start elephant.service >>"$LOG" 2>&1; then
      log 'systemctl start failed; falling back to background elephant'
      elephant >>"$LOG" 2>&1 &
    fi
  fi

  local i
  for i in $(seq 1 80); do
    if _elephant_ready && _elephant_has_apps; then
      log "elephant ready with apps (${i} checks)"
      return 0
    fi
    sleep 0.25
  done

  if _elephant_ready; then
    log "elephant providers loaded but desktop query empty: $(elephant query 'desktopapplications;;5;false' 2>&1 | tr '\n' ' ')"
    return 0
  fi

  log "elephant not ready; providers: $(elephant l 2>&1 | tr '\n' ' ')"
  return 1
}

start_walker_service() {
  command -v walker >/dev/null 2>&1 || {
    log 'walker not installed'
    return 0
  }

  pkill -f '[w]alker --gapplication-service' 2>/dev/null || true
  sleep 0.2

  walker --gapplication-service >>"$LOG" 2>&1 &
  log 'started walker --gapplication-service'
}

: >"$LOG"
start_elephant || true
start_walker_service
