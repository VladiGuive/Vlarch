#!/usr/bin/env bash
# Waybar: show V⤴ when CDN version is newer than installed; open update in Kitty on click.

set -euo pipefail

VLARCH_CDN_BASE="${VLARCH_CDN_BASE:-https://vlarch.vladi.tech}"
VLARCH_INFO_FILE="${VLARCH_INFO_FILE:-/etc/vlarch/install-info}"
# Must match "signal" on custom/vlarch-update in waybar config.jsonc.
VLARCH_WAYBAR_UPDATE_SIGNAL="${VLARCH_WAYBAR_UPDATE_SIGNAL:-1}"

_vlarch_local_version() {
  [[ -f "$VLARCH_INFO_FILE" ]] || return 1
  grep -E '^version=' "$VLARCH_INFO_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]'
}

_vlarch_remote_version() {
  curl -fsSL --max-time 10 "${VLARCH_CDN_BASE}/version.txt" | tr -d '[:space:]'
}

_vlarch_update_available() {
  local local_ver remote_ver newest
  local_ver="$(_vlarch_local_version)" || return 1
  remote_ver="$(_vlarch_remote_version)" || return 1
  [[ -n "$local_ver" && -n "$remote_ver" ]] || return 1
  [[ "$local_ver" == "$remote_ver" ]] && return 1
  newest="$(printf '%s\n%s\n' "$local_ver" "$remote_ver" | sort -V | tail -1)"
  [[ "$newest" == "$remote_ver" ]]
}

_vlarch_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

vlarch_waybar_status() {
  local remote_ver
  if ! _vlarch_update_available; then
    printf '{"text":""}\n'
    return 0
  fi
  remote_ver="$(_vlarch_remote_version)"
  printf '{"text":"V󰚰","tooltip":"↑ %s","class":"pending"}\n' \
    "$(_vlarch_json_escape "$remote_ver")"
}

vlarch_waybar_refresh() {
  pgrep -x waybar >/dev/null 2>&1 || return 0
  pkill "-SIGRTMIN+${VLARCH_WAYBAR_UPDATE_SIGNAL}" waybar 2>/dev/null \
    || killall -SIGUSR2 waybar 2>/dev/null \
    || true
}

vlarch_waybar_session() {
  local key

  sudo vlarch update || true
  vlarch_waybar_refresh

  printf '\n\e[38;5;150mEnter\e[0m reboot · \e[38;5;150mEsc\e[0m close\n'
  while true; do
    IFS= read -rsn1 key </dev/tty 2>/dev/null || break
    if [[ "$key" == $'\e' ]]; then
      read -rsn2 -t 0.01 _ </dev/tty 2>/dev/null || true
      break
    fi
    if [[ -z "$key" || "$key" == $'\n' || "$key" == $'\r' ]]; then
      sudo systemctl reboot
    fi
  done
}

vlarch_waybar_open() {
  command -v kitty >/dev/null 2>&1 || {
    printf 'kitty not found\n' >&2
    exit 1
  }
  kitty --title 'vlarch update' -e vlarch-waybar-update --session &
  sleep 0.3
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch focuswindow "title:vlarch update" 2>/dev/null || true
    hyprctl dispatch centerwindow 2>/dev/null || true
  fi
}

case "${1:---status}" in
  --status)  vlarch_waybar_status ;;
  --open)    vlarch_waybar_open ;;
  --session) vlarch_waybar_session ;;
  --refresh) vlarch_waybar_refresh ;;
  -h|--help)
    printf 'usage: %s [--status|--open|--session|--refresh]\n' "$(basename "$0")"
    ;;
  *)
    printf 'unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac
