#!/usr/bin/env bash
# Waybar: show V⤴ when CDN version is newer than installed; open update in Kitty on click.

set -euo pipefail

VLARCH_INFO_FILE="${VLARCH_INFO_FILE:-/etc/vlarch/install-info}"
VLARCH_STATE_DIR="${VLARCH_STATE_DIR:-/var/lib/vlarch}"
VLARCH_WAYBAR_UPDATE_FAILED_FILE="${VLARCH_WAYBAR_UPDATE_FAILED_FILE:-${VLARCH_STATE_DIR}/update-failed}"
# Must match "signal" on custom/vlarch-update in waybar config.jsonc.
VLARCH_WAYBAR_UPDATE_SIGNAL="${VLARCH_WAYBAR_UPDATE_SIGNAL:-1}"

_vlarch_install_branch() {
  local branch=""
  [[ -f "$VLARCH_INFO_FILE" ]] || { printf '%s' main; return 0; }
  branch="$(grep -E '^branch=' "$VLARCH_INFO_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
  printf '%s' "${branch:-main}"
}

_vlarch_cdn_base_for_branch() {
  local branch="${1:-main}"
  branch="${branch//\//-}"
  if [[ "$branch" == main ]]; then
    printf 'https://vlarch.vladi.tech'
  else
    printf 'https://vlarch-%s.vladi.tech' "$branch"
  fi
}

if [[ -z "${VLARCH_CDN_BASE:-}" ]]; then
  VLARCH_CDN_BASE="$(_vlarch_cdn_base_for_branch "$(_vlarch_install_branch)")"
fi

_vlarch_source_version_lib() {
  local lib share="${VLARCH_SHARE_DIR:-/usr/local/share/vlarch}"

  lib="${share}/version.sh"
  if [[ -f "$lib" ]]; then
    # shellcheck disable=SC1090
    source "$lib"
    return 0
  fi

  local self_root=""
  local self="${BASH_SOURCE[0]:-}"
  if [[ -n "$self" && -f "$self" ]]; then
    self_root="$(cd -- "$(dirname -- "$self")" && pwd -P)"
    lib="${self_root}/../lib/version.sh"
    if [[ -f "$lib" ]]; then
      # shellcheck disable=SC1090
      source "$lib"
      return 0
    fi
  fi

  if [[ -n "${VLARCH_CDN_BASE:-}" ]]; then
    lib="$(mktemp)"
    if curl -fsSL --max-time 10 "${VLARCH_CDN_BASE}/lib/version.sh" -o "$lib" 2>/dev/null; then
      # shellcheck disable=SC1090
      source "$lib"
      rm -f "$lib"
      return 0
    fi
    rm -f "$lib"
  fi

  return 1
}

_vlarch_local_version() {
  [[ -f "$VLARCH_INFO_FILE" ]] || return 1
  grep -E '^version=' "$VLARCH_INFO_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]'
}

_vlarch_remote_version() {
  curl -fsSL --max-time 10 "${VLARCH_CDN_BASE}/version.txt" | tr -d '[:space:]'
}

_vlarch_update_available() {
  local local_ver remote_ver
  local_ver="$(_vlarch_local_version)" || return 1
  remote_ver="$(_vlarch_remote_version)" || return 1
  _vlarch_source_version_lib || return 1
  vlarch_update_available "$local_ver" "$remote_ver"
}

_vlarch_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

_vlarch_waybar_clear_failed() {
  sudo rm -f "$VLARCH_WAYBAR_UPDATE_FAILED_FILE" 2>/dev/null || true
}

_vlarch_waybar_mark_failed() {
  local msg="$1"
  sudo install -d -m 0755 "${VLARCH_WAYBAR_UPDATE_FAILED_FILE%/*}" 2>/dev/null \
    || return 0
  printf '%s\n' "$msg" | sudo tee "$VLARCH_WAYBAR_UPDATE_FAILED_FILE" >/dev/null 2>&1 \
    || true
}

_vlarch_waybar_failed_message() {
  [[ -r "$VLARCH_WAYBAR_UPDATE_FAILED_FILE" ]] || return 1
  head -1 "$VLARCH_WAYBAR_UPDATE_FAILED_FILE" 2>/dev/null
}

vlarch_waybar_show_error() {
  local msg="$1"
  local width=50 lines=10

  if [[ -t 1 ]]; then
    stty cols "$width" rows "$lines" 2>/dev/null || true
    printf '\033[8;%d;%dt' "$lines" "$width"
    clear || true
  fi

  printf '%b' '\033[38;5;109m'
  cat <<'LOGO'
 _   ____             __
| | / / /__ _________/ /
| |/ / / _ `/ __/ __/ _ \
|___/_/\_,_/_/  \__/_//_/
LOGO
  printf '%b' '\033[0m\n'
  printf '%b%b%b\n' '\033[38;5;176m' "$msg" '\033[0m'
  printf '\n'
  printf '%bUpdate failed%b\n' '\033[38;5;174m' '\033[0m'
  printf 'Try: vlarch update --verbose\n'
  printf '\n'
  printf '%bEsc%b → close.\n' '\033[38;5;221m' '\033[0m'
  printf '%b\033[%d;1H\033[?25l' '\033[0m' "$lines"
}

vlarch_waybar_status() {
  local remote_ver failed_msg
  if failed_msg="$(_vlarch_waybar_failed_message)"; then
    printf '{"text":"V󰚰","tooltip":"%s","class":"failed"}\n' \
      "$(_vlarch_json_escape "$failed_msg")"
    return 0
  fi
  if ! _vlarch_update_available; then
    printf '{"text":""}\n'
    return 0
  fi
  remote_ver="$(_vlarch_remote_version)"
  printf '{"text":"V󰚰","tooltip":"↑ %s","class":"pending"}\n' \
    "$(_vlarch_json_escape "$remote_ver")"
}

vlarch_waybar_refresh() {
  pgrep -x waybar >/dev/null 2>&1 || return 0
  pkill "-SIGRTMIN+${VLARCH_WAYBAR_UPDATE_SIGNAL}" waybar 2>/dev/null \
    || killall -SIGUSR2 waybar 2>/dev/null \
    || true
}

vlarch_waybar_session() {
  local key rc=0 err_msg

  _vlarch_waybar_clear_failed
  sudo VLARCH_CDN_BASE="$VLARCH_CDN_BASE" vlarch update || rc=$?
  vlarch_waybar_refresh

  if ((rc != 0)); then
    err_msg="Update failed (exit ${rc})"
    _vlarch_waybar_mark_failed "$err_msg"
    vlarch_waybar_refresh
    vlarch_waybar_show_error "$err_msg"
    stty -echo -icanon time 0 min 0 2>/dev/null || true
    while true; do
      IFS= read -rsn1 key </dev/tty 2>/dev/null || break
      if [[ "$key" == $'\e' ]]; then
        read -rsn2 -t 0.01 _ </dev/tty 2>/dev/null || true
        break
      fi
    done
    stty sane 2>/dev/null || true
    printf '%b' '\033[?25h'
    return "$rc"
  fi

  _vlarch_waybar_clear_failed
  vlarch_waybar_refresh

  # Prompts are drawn by vlarch_ui_show_complete; only read keys here.
  stty -echo -icanon time 0 min 0 2>/dev/null || true
  while true; do
    IFS= read -rsn1 key </dev/tty 2>/dev/null || break
    if [[ "$key" == $'\e' ]]; then
      read -rsn2 -t 0.01 _ </dev/tty 2>/dev/null || true
      break
    fi
    if [[ -z "$key" || "$key" == $'\n' || "$key" == $'\r' ]]; then
      stty sane 2>/dev/null || true
      printf '%b' '\033[?25h'
      sudo systemctl reboot
    fi
  done
  stty sane 2>/dev/null || true
  printf '%b' '\033[?25h'
}

_vlarch_hypr_active_workspace() {
  hyprctl activeworkspace -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])'
}

_vlarch_hypr_update_window_addr() {
  hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
for c in json.load(sys.stdin):
    if c.get("title") == "vlarch update":
        print(c["address"])
        break
'
}

_vlarch_hypr_focus_update_window() {
  local ws="$1"
  local addr="$2"

  [[ -n "$ws" && -n "$addr" ]] || return 0
  hyprctl dispatch movetoworkspacesilent "${ws},address:${addr}" 2>/dev/null || true
  hyprctl dispatch focuswindow "address:${addr}" 2>/dev/null || true
  hyprctl dispatch centerwindow 2>/dev/null || true
}

vlarch_waybar_open() {
  local ws addr

  command -v kitty >/dev/null 2>&1 || {
    printf 'kitty not found\n' >&2
    exit 1
  }

  ws=""
  if command -v hyprctl >/dev/null 2>&1; then
    ws="$(_vlarch_hypr_active_workspace 2>/dev/null || true)"
    addr="$(_vlarch_hypr_update_window_addr 2>/dev/null || true)"
    if [[ -n "$addr" ]]; then
      _vlarch_hypr_focus_update_window "$ws" "$addr"
      return 0
    fi
  fi

  kitty --title 'vlarch update' \
    -o remember_window_size=no \
    -o initial_window_width=50c \
    -o initial_window_height=10c \
    -o window_padding_width=0 \
    -o window_margin_width=0 \
    -o cursor_trail=0 \
    -e vlarch-waybar-update --session &
  sleep 0.3

  if command -v hyprctl >/dev/null 2>&1; then
    addr="$(_vlarch_hypr_update_window_addr 2>/dev/null || true)"
    _vlarch_hypr_focus_update_window "$ws" "$addr"
  fi
}

case "${1:---status}" in
  --status)  vlarch_waybar_status ;;
  --open)    vlarch_waybar_open ;;
  --session) vlarch_waybar_session ;;
  --refresh) vlarch_waybar_refresh ;;
  -h|--help)
    printf 'usage: %s [--status|--open|--session|--refresh]\n' "$(basename "$0")"
    ;;
  *)
    printf 'unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac
