#!/usr/bin/env bash
# Open Walker via its background service (layer overlay). Ensures the service is up first.

set -euo pipefail

# Match vlarch-nord layout.xml box-wrapper width/height requests.
VLARCH_WALKER_WIDTH="${VLARCH_WALKER_WIDTH:-600}"
VLARCH_WALKER_HEIGHT="${VLARCH_WALKER_HEIGHT:-570}"

_service_running() {
  pgrep -f '[w]alker --gapplication-service' >/dev/null 2>&1
}

_ensure_service() {
  _service_running && return 0
  command -v vlarch-walker-services >/dev/null 2>&1 || return 1
  vlarch-walker-services
  local i
  for i in $(seq 1 40); do
    _service_running && return 0
    sleep 0.1
  done
  return 1
}

_close_walker_ui() {
  command -v walker >/dev/null 2>&1 || return 0
  walker -q 2>/dev/null || true
}

_ensure_service || true

if [[ $# -eq 0 ]]; then
  # Always open the default launcher at theme dimensions. Socket toggle kept
  # stale provider layouts (e.g. menus:keybinds preview width) after an update.
  _close_walker_ui
  exec walker --width "$VLARCH_WALKER_WIDTH" --height "$VLARCH_WALKER_HEIGHT"
fi

_close_walker_ui
exec walker "$@"
