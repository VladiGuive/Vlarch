pre.frames[13] = Image("animation-0013.png");
pre.frames[14] = Image("animation-0014.png");
pre.frames[15] = Image("animation-0015.png");
pre.sprite = Sprite(pre.frames[1]);
pre.sprite.SetPosition(0, 0, 1);
pre.index = 1;

