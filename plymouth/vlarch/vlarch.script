# Password dialog (bottom, no keyboard)
fun dialog_setup ()
  {
    local.cx;
    local.cy;

    cx = Window.GetX() + Window.GetWidth() / 2;
    cy = Window.GetY() + Window.GetHeight() - 150;

    dialog.prompt_text = Image.Text("Enter encryption password.", 1, 1, 1);
    dialog.prompt = Sprite(dialog.prompt_text);
    dialog.prompt.SetPosition(cx - dialog.prompt_text.GetWidth() / 2, cy - 70, 10000);

    dialog.lock_image = Image("lock.png");
    dialog.entry_image = Image("entry.png");
    dialog.bullet_image = Image("bullet.png");

    dialog.lock = Sprite(dialog.lock_image);
    dialog.entry = Sprite(dialog.entry_image);
    dialog.entry_x = cx - dialog.entry_image.GetWidth() / 2;
    dialog.entry_y = cy;
    dialog.lock.SetPosition(dialog.entry_x - dialog.lock_image.GetWidth(), cy, 10001);
    dialog.entry.SetPosition(dialog.entry_x, cy, 10001);
  }

fun dialog_hide ()
  {
    dialog.prompt.SetOpacity(0);
    dialog.lock.SetOpacity(0);
    dialog.entry.SetOpacity(0);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].SetOpacity(0);
  }

password_requested = false;
post_active = false;
pre.ticks = 0;
post.ticks = 0;

fun refresh_callback ()
  {
    # pre animation loops while waiting (until the post animation starts).
    # The plugin refresh runs at 50fps; advance one frame every 3 ticks to
    # replay the source video (15fps) at its original speed.
    if (!post_active)
      {
        pre.ticks++;
        if (pre.ticks >= 3)
          {
            pre.ticks = 0;
            pre.index++;
            if (pre.index > 15)
              pre.index = 1;
            pre.sprite.SetImage(pre.frames[pre.index]);
          }
      }

    # post animation plays once after the password
    if (post_active)
      {
        post.ticks++;
        if (post.ticks >= 3)
          {
            post.ticks = 0;
            post.index++;
            if (post.index > 60)
              post_active = false;
            else
              post.sprite.SetImage(post.frames[post.index]);
          }
      }
  }

fun display_password_callback (prompt, bullets)
  {
    # show the dialog right away (never leave the prompt waiting on the refresh)
    if (!dialog.prompt)
      dialog_setup();
    password_requested = true;

    for (index = 0; dialog.bullet[index] || index < bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            dialog.bullet[index] = Sprite(dialog.bullet_image);
            dialog.bullet[index].SetPosition(dialog.entry_x + index * dialog.bullet_image.GetWidth(), dialog.entry_y + dialog.entry_image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2, 10002);
          }
        if (index < bullets)
          dialog.bullet[index].SetOpacity(1);
        else
          dialog.bullet[index].SetOpacity(0);
      }
  }

fun display_normal_callback ()
  {
    if (password_requested)
      {
        # password resolved: stop the pre animation, play the post once
        password_requested = false;
        post_active = true;
        post.index = 0;
        dialog_hide();
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
