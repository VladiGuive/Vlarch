# Vlarch custom splash
# - full-screen background (placeholder image)
# - pre-prompt cube animation (video seconds 6-7), plays once, then hides
# - LUKS password prompt at the bottom (no keyboard), bullets visible
# - post animation (video seconds 1-5), plays once after the password
#
# The 60 post frames (~500MB raw) are NOT loaded at script load: their
# names are stored as strings and the images are loaded one per refresh
# tick while the password prompt is shown, so the initramfs never needs
# all of them in RAM at once.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Full-screen background
background.image = Image("background.png");
background.sprite = Sprite(background.image);
background.sprite.SetPosition(0, 0, 0);

# Password dialog, hidden until the pre animation ends
dialog.lock = Sprite(Image("lock.png"));
dialog.entry = Sprite(Image("entry.png"));
dialog.bullet_image = Image("bullet.png");
dialog.entry_x = 770;
dialog.entry_y = 930;
dialog.lock.SetPosition(730, dialog.entry_y, 10001);
dialog.entry.SetPosition(dialog.entry_x, dialog.entry_y, 10001);
dialog.lock.SetOpacity(0);
dialog.entry.SetOpacity(0);
for (i = 0; i < 24; i++)
  {
    dialog.bullet[i] = Sprite(dialog.bullet_image);
    dialog.bullet[i].SetPosition(dialog.entry_x + 8 + i * (dialog.bullet_image.GetWidth() + 4), dialog.entry_y + 12, 10002);
    dialog.bullet[i].SetOpacity(0);
  }

password_requested = false;
post_active = false;
pre.done = false;
post.next_loaded = 0;
post.all_loaded = false;

fun refresh_callback ()
  {
    # pre animation plays ONCE, then hides so the background shows
    if (!pre.done && !post_active)
      {
        pre.index++;
        if (pre.index > 15)
          {
            pre.done = true;
            pre.sprite.SetOpacity(0);
            dialog.entry.SetOpacity(1);
            dialog.lock.SetOpacity(1);
          }
        else if (pre.frames[pre.index])
          pre.sprite.SetImage(pre.frames[pre.index]);
      }

    # load one post frame per tick while the password prompt is shown
    if (pre.done && !post_active && !post.all_loaded)
      {
        post.next_loaded++;
        if (post.next_loaded > 60)
          post.all_loaded = true;
        else
          post.frames[post.next_loaded] = Image(post.names[post.next_loaded]);
      }

    # post animation plays once after the password
    if (post_active)
      {
        post.index++;
        if (post.index > 60)
          post_active = false;
        else if (post.frames[post.index])
          post.sprite.SetImage(post.frames[post.index]);
      }
  }

fun display_password_callback (prompt, bullets)
  {
    dialog.entry.SetOpacity(1);
    dialog.lock.SetOpacity(1);
    password_requested = true;
    for (i = 0; i < 24; i++)
      {
        if (i < bullets)
          dialog.bullet[i].SetOpacity(1);
        else
          dialog.bullet[i].SetOpacity(0);
      }
  }

fun display_normal_callback ()
  {
    if (password_requested)
      {
        password_requested = false;
        post_active = true;
        post.index = 0;
        dialog.entry.SetOpacity(0);
        dialog.lock.SetOpacity(0);
        for (i = 0; i < 24; i++)
          dialog.bullet[i].SetOpacity(0);
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- animation frames ----
pre.frames[1] = Image("animation-0001.png");
pre.frames[2] = Image("animation-0002.png");
pre.frames[3] = Image("animation-0003.png");
