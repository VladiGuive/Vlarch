# Vlarch custom splash - pointing-arrow animation (rewrite 2026-08)
#
# - full-screen golden arrow sweeping left-to-right (first 50 frames of the
#   video, mostly black background), played once at 50fps
# - when it ends the LAST FRAME IS HELD and the password dialog spawns at
#   the bottom (theme-driven: the encrypt hook's request only records
#   password_requested, it does NOT force the dialog visible)
# - on password entry the SAME 50 frames play in REVERSE (post animation)
#
# Lessons baked in (each one bricked/hung a boot until fixed):
# - NO array literals (the interpreter has none - `= [];` fails to load)
# - callbacks are registered BEFORE the frame Image() loads, so a failed
#   load can never skip the password registration
# - every SetImage is guarded (if (frames[i])) - a failed Image() degrades
#   to a partial animation, never a brick
# - all dialog sprites are created at load time, shown/hidden via SetOpacity
# - one shared 50-frame set serves both animations (1->50 pre, 50->1 post)

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ---- state ----
password_requested = false;
dialog.visible = false;
dialog.bullets = 0;
anim.mode = "pre";          # pre -> hold -> post -> done
anim.index = 1;

fun apply_bullets ()
  {
    for (i = 0; i < 24; i++)
      {
        if (i < dialog.bullets)
          dialog.bullet[i].SetOpacity(1);
        else
          dialog.bullet[i].SetOpacity(0);
      }
  }

fun show_dialog ()
  {
    dialog.visible = true;
    dialog.entry.SetOpacity(1);
    dialog.lock.SetOpacity(1);
    apply_bullets();
  }

fun hide_dialog ()
  {
    dialog.visible = false;
    dialog.entry.SetOpacity(0);
    dialog.lock.SetOpacity(0);
    for (i = 0; i < 24; i++)
      dialog.bullet[i].SetOpacity(0);
  }

fun refresh_callback ()
  {
    if (anim.mode == "pre")
      {
        anim.index++;
        if (anim.index > 50)
          {
            anim.mode = "hold";     # hold last frame + spawn password field
            show_dialog();
          }
        else if (frames[anim.index])
          anim.sprite.SetImage(frames[anim.index]);
      }
    else if (anim.mode == "post")
      {
        anim.index--;
        if (anim.index < 1)
          anim.mode = "done";       # hold first frame until boot ends
        else if (frames[anim.index])
          anim.sprite.SetImage(frames[anim.index]);
      }
  }

fun display_password_callback (prompt, bullets)
  {
    password_requested = true;
    dialog.bullets = bullets;
    if (dialog.visible)
      apply_bullets();              # typing: refresh bullets in place
    else if (anim.mode == "post" || anim.mode == "done")
      {
        # password rejected: back to the held last frame + dialog
        anim.mode = "hold";
        anim.index = 50;
        if (frames[50])
          anim.sprite.SetImage(frames[50]);
        show_dialog();
      }
    # mode == "pre": dialog appears on its own when the pre ends
  }

fun display_normal_callback ()
  {
    if (password_requested)
      {
        password_requested = false;
        hide_dialog();
        anim.mode = "post";
        anim.index = 51;            # first post tick shows frame 50 (held)
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- password dialog (created at load, hidden; theme decides when to show) ----
dialog.lock = Sprite(Image("lock.png"));
dialog.entry = Sprite(Image("entry.png"));
dialog.bullet_image = Image("bullet.png");
dialog.entry_x = 770;
dialog.entry_y = 930;
dialog.lock.SetPosition(730, dialog.entry_y, 10001);
dialog.entry.SetPosition(dialog.entry_x, dialog.entry_y, 10001);
dialog.lock.SetOpacity(0);
dialog.entry.SetOpacity(0);
for (i = 0; i < 24; i++)
  {
    dialog.bullet[i] = Sprite(dialog.bullet_image);
    dialog.bullet[i].SetPosition(dialog.entry_x + 8 + i * (dialog.bullet_image.GetWidth() + 4), dialog.entry_y + 12, 10002);
    dialog.bullet[i].SetOpacity(0);
  }

# ---- animation frames (loaded AFTER the callbacks are registered) ----
frames[1] = Image("animation-0001.png");
frames[2] = Image("animation-0002.png");
frames[3] = Image("animation-0003.png");
