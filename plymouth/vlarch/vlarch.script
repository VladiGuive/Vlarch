# Vlarch custom splash
# - full-screen background (placeholder image)
# - pre-prompt cube animation (video seconds 6-7), loops while waiting
# - LUKS password prompt at the bottom (no keyboard)
# - post animation (video seconds 1-5), plays once right after the password
#
# Callbacks are registered BEFORE the animation frames are loaded, so a
# failing Image() (large 1080p frames in the initramfs) can never leave
# the password prompt unhandled.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

background.image = Image("background.png");
background.sprite = Sprite(background.image);
background.sprite.SetPosition(0, 0, 0);

password_requested = false;
post_active = false;
pre.done = false;

fun refresh_callback ()
  {
    # pre animation plays ONCE (no loop): a 50fps loop of 1080p frames
    # saturates the plymouth event loop and the LUKS password request
    # never gets processed.
    if (!pre.done && !post_active)
      {
        pre.index++;
        if (pre.index > 15)
          pre.done = true;
        else if (pre.frames[pre.index])
          pre.sprite.SetImage(pre.frames[pre.index]);
      }

    # post animation plays once after the password
    if (post_active)
      {
        post.index++;
        if (post.index > 60)
          post_active = false;
        else if (post.frames[post.index])
          post.sprite.SetImage(post.frames[post.index]);
      }
  }

fun dialog_show ()
  {
    local.cx;
    local.cy;

    cx = Window.GetX() + Window.GetWidth() / 2;
    cy = Window.GetY() + Window.GetHeight() - 150;

    dialog.lock_image = Image("lock.png");
    dialog.entry_image = Image("entry.png");
    dialog.lock = Sprite(dialog.lock_image);
    dialog.entry = Sprite(dialog.entry_image);
    dialog.entry_x = cx - dialog.entry_image.GetWidth() / 2;
    dialog.entry_y = cy;
    dialog.lock.SetPosition(dialog.entry_x - dialog.lock_image.GetWidth(), cy, 10001);
    dialog.entry.SetPosition(dialog.entry_x, cy, 10001);
  }

fun display_password_callback (prompt, bullets)
  {
    if (!dialog.entry)
      dialog_show();
    password_requested = true;
  }

fun display_normal_callback ()
  {
    if (password_requested)
      {
        # password resolved: stop the pre animation, play the post once
        password_requested = false;
        post_active = true;
        post.index = 0;
        if (dialog.entry)
          {
            dialog.entry.SetOpacity(0);
            dialog.lock.SetOpacity(0);
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- animation frames (loaded after the callbacks are registered) ----
pre.frames[1] = Image("animation-0001.png");
pre.frames[2] = Image("animation-0002.png");
pre.frames[3] = Image("animation-0003.png");
pre.frames[4] = Image("animation-0004.png");
