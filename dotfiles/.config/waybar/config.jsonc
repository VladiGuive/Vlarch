{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "backlight",
    "battery",
    "hyprland/language",
    "custom/lock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch split-workspace e-1",
    "on-scroll-down": "hyprctl dispatch split-workspace e+1",
    "format": "{icon}",
    "all-outputs": false,
    "format-icons": {
      "urgent": "",
      "active": "",
      "visible": "",
      "default": "",
      "empty": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%d/%m/%Y}",
    "format": " {:%H:%M}"
  },
  "backlight": {
    "format": "{icon}",
    "on-scroll-up": "brightnessctl s '+10%'",
    "on-scroll-down": "brightnessctl s '10%-'",
    "on-click": "((( $(brightnessctl g) == 100 )) && brightnessctl s '0') || (brightnessctl s '+10%')",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "",
    "format-alt": "{capacity}%",
    "tooltip-format": "{capacity}% — {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
	"custom/lock": {
		"tooltip": false,
		"on-click": "reboot",
		"format": "󰜉"
	},
  "custom/power": {
    "tooltip": false,
    "on-click": "sudo systemctl poweroff",
    "format": "⏻"
  },
  "hyprland/language": {
    "format": " {}",
    "format-en": "en",
    "format-fa": "fa",
    "interval": 1,
    "on-click": "hyprctl switchxkblayout all next"
  }
}
