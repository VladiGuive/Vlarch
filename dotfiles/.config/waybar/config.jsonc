{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/vlarch-update",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "custom/vlarch-wifi",
    "backlight",
    "custom/vlarch-battery",
    "hyprland/language",
    "custom/lock",
    "custom/power"
  ],
  "custom/vlarch-update": {
    "format": "{}",
    "return-type": "json",
    "exec": "vlarch-waybar-update --status",
    "interval": 60,
    "signal": 1,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "vlarch-waybar-update --open"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "sort-by-number": true,
    "all-outputs": false,
    "format-icons": {
      "urgent": "",
      "active": "",
      "visible": "",
      "default": "",
      "empty": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%d/%m/%Y}",
    "format": " {:%H:%M}"
  },
  "backlight": {
    "format": "{icon}",
    "tooltip-format": "{percent}% brightness",
    "on-scroll-up": "brightnessctl s '+10%'",
    "on-scroll-down": "brightnessctl s '10%-'",
    "on-click": "((( $(brightnessctl g) == 100 )) && brightnessctl s '0') || (brightnessctl s '+10%')",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },
  "custom/vlarch-battery": {
    "format": "{}",
    "return-type": "json",
    "exec": "vlarch-waybar-battery --status",
    "interval": 60,
    "signal": 3,
    "hide-empty-text": true,
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/vlarch-wifi": {
    "format": "{}",
    "return-type": "json",
    "exec": "vlarch-waybar-wifi --status",
    "interval": 5,
    "signal": 2,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "vlarch-waybar-wifi --open"
  },
	"custom/lock": {
		"tooltip": false,
		"on-click": "reboot",
		"format": "󰜉"
	},
  "custom/power": {
    "tooltip": false,
    "on-click": "sudo systemctl poweroff",
    "format": "⏻"
  },
  "hyprland/language": {
    "format": " {}",
    "format-en": "en",
    "format-fa": "fa",
    "interval": 1,
    "on-click": "hyprctl switchxkblayout all next"
  }
}
